# HTTPS-режим для мобильной проверки (`npm run dev:https`, = vite --mode https).
# В этом режиме Vite проксирует /api к локальному PocketBase (127.0.0.1:8090),
# поэтому приложение работает через ТОТ ЖЕ origin, что и фронтенд
# (https://<LAN-IP>:5173) — браузер на телефоне не получает mixed-content и
# разрешает доступ к микрофону (secure context).
#
# Пустой URL = относительный (same-origin). PocketBase SDK это поддерживает.
VITE_PB_URL=
